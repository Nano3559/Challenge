{
  "name": "qa-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Framework de automatización con Playwright (API + UI) para GAD (GUI + API)",
  "scripts": {
    "app": "npm --prefix gad-gui-api-demo start",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:failed": "playwright test --last-failed",
    "test:debug": "playwright test --debug",
    "coverage:record": "node tools/coverage/bin/record-tests.js",
    "coverage:cli": "node coverage-cli.js",
    "coverage:analyze": "node coverage-cli.js --spec gad-gui-api-demo/public/tools/schema/openapi_rest_demo.json --requests reports/coverage/requests --out reports/coverage --min-coverage 0",
    "coverage:baseline": "node coverage-cli.js --spec gad-gui-api-demo/public/tools/schema/openapi_rest_demo.json --requests reports/coverage/requests --out . --ai-estimates tools/coverage/ai-estimates.json",
    "coverage:compare": "node tools/coverage/bin/compare-coverage.js",
    "coverage:all": "npm run coverage:record -- --project=api && npm run coverage:analyze",
    "test:coverage:unit": "node --test \"tools/coverage/test/*.test.js\"",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ci:check": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "c8": "^10.1.3",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
