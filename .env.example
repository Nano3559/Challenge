# Copia a .env (o .env.qa / .env.stage) y ajusta. Seleccionar ambiente: ENV=qa npm test
ENV=local
BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Credenciales de GAD (super admin por defecto)
QA_USER=admin
QA_PASS=admin
# Usuario del dataset base para GET /api/login (el super admin no pertenece al dataset)
QA_REGISTERED_USER=Moses.Armstrong@Feest.ca
QA_REGISTERED_PASS=test1
# Usuario del dataset base con permiso manage-books y cuenta de librería
QA_BOOK_MANAGER_USER=v.cortez@test.test
QA_BOOK_MANAGER_PASS=1234
# Usuario con cuenta de librería de rol lector, sin permiso manage-books
QA_BOOK_READER_USER=Danial.Dicki@dicki.test
QA_BOOK_READER_PASS=test2
# true = Playwright levanta GAD por sí mismo; false = lo levantás vos
START_APP=false
APP_START_COMMAND=npm --prefix gad-gui-api-demo start
# Grabación de solicitudes para el análisis de cobertura OpenAPI
COVERAGE_REQUESTS=false
COVERAGE_REQUESTS_DIR=reports/coverage/requests
